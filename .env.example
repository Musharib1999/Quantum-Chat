# Gemini API Key
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# MongoDB Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/quantum-chat
MONGODB_URI=

# Optional: Groq API Key (Fallback)
GROQ_API_KEY=

# Quantum Services (Independent Microservices)
# Default for local: http://127.0.0.1:8001/8002
QISKIT_SERVICE_URL=
DWAVE_SERVICE_URL=

# Market Service
MARKET_SERVICE_URL=https://your-market-service.vercel.app
MARKET_SERVICE_KEY=your_shared_secret_key
