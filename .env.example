# MongoDB Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/quantum-chat
MONGODB_URI=

# Groq API Key
# Obtain from: https://console.groq.com/keys
GROQ_API_KEY=

# Market Service (Separate Repo)
MARKET_SERVICE_URL=https://your-market-service.vercel.app
MARKET_SERVICE_KEY=your_shared_secret_key
